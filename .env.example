# Telegram
TELEGRAM_TOKEN=123456:ABC-your-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-service-xxxxx.run.app/webhook
TELEGRAM_WEBHOOK_SECRET=random-long-secret-string-here
TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Apple iCloud CalDAV
ICLOUD_USER=your.apple.id@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=משפחה

# Google Gemini (free tier at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Parent Telegram user IDs
TAL_TELEGRAM_ID=111111111
BEN_TELEGRAM_ID=222222222

# SQLite
DB_PATH=./data/family_calendar.db

# Morning routine
MORNING_HOUR=7
MORNING_MINUTE=0

# Logging
LOG_LEVEL=INFO

# Cloud Run
PORT=8080
